# =============================================================================
# The Kings Tribe — TRAINING environment variables (names only, no values)
# See docs/training/TRAINING-ENVIRONMENT.md before filling anything in.
#
# Local use:  cp .env.training.example .env.training.local   (git-ignored)
# Fill in values from the TRAINING Supabase project ONLY. Never copy a value
# from production, from .env.local, or from the production Vercel project.
# Never paste these values into chat, tickets or documents.
# =============================================================================

# ---- Training mode (turns on the banner, "TKT Training" name and production-database refusal) ----
NEXT_PUBLIC_APP_ENVIRONMENT=training

# ---- TRAINING Supabase project (never the production project) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret, server-only.
SUPABASE_SECRET_KEY=

# The training app address, no trailing slash (http://localhost:3000 locally, later the training *.vercel.app address).
NEXT_PUBLIC_APP_URL=
# A NEW random value used once at /setup for the training administrator, then removed. Never production's.
SETUP_TOKEN=

# ---- Used only by scripts/training/training-db.sh (local file only; never added to Vercel) ----
# The training project's reference (20 lowercase letters/digits).
TRAINING_PROJECT_REF=
# The training database connection string (percent-encoded). Contains the database password: secret.
TRAINING_DB_URL=

# ---- Deliberately left out in training: email, inbound email, delivery webhook, phone alerts and SMS ----
# Do NOT add RESEND_API_KEY, EMAIL_FROM, RECEIPTS_INBOUND_ADDRESS, RESEND_WEBHOOK_SECRET,
# RESEND_DELIVERY_WEBHOOK_SECRET, NEXT_PUBLIC_VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
# or any TWILIO_* variable. A training-only VAPID key pair may be added later only with explicit approval.
