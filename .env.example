# =============================================================================
# The Kings Tribe — Finance & Operations · environment variables
# Copy to .env.local for local development:   cp .env.example .env.local
# Add the same names in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. .env* files are git-ignored (except this example).
# =============================================================================

# ---- Browser-safe (sent to the browser; protected by Row Level Security) ----
# Supabase → Project Settings → API (or "Connect") → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_…)
# (Older projects: the "anon public" key also works here.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The address people use to reach the app, no trailing slash.
# Local: http://localhost:3000   Production: https://your-app.vercel.app or https://app.yourchurch.org
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Server-only SECRETS (never exposed to the browser) ----
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…)
# (Older projects: the "service_role" key.) Bypasses RLS — server use only.
SUPABASE_SECRET_KEY=
# A long random value (24+ characters) used once to create the first Administrator at /setup.
# Generate one in Terminal:   openssl rand -base64 32
SETUP_TOKEN=

# ---- Email (Resend) — server-only ----
# Resend → API Keys → Create API key (secret)
RESEND_API_KEY=
# Verified sender, e.g.:  The Kings Tribe Finance <finance@yourchurch.org>
EMAIL_FROM=
# Mailbox that receives receipt replies (Resend Receiving), e.g. receipts@inbound.yourchurch.org
# Replies are routed with plus-addresses such as receipts+po-<token>@inbound.yourchurch.org
RECEIPTS_INBOUND_ADDRESS=
# Resend → Webhooks → (your email.received endpoint) → Signing secret (whsec_…) — secret
RESEND_WEBHOOK_SECRET=
# Resend → Webhooks → (the delivery-status endpoint …/api/email-events) → Signing secret (whsec_…) — secret
RESEND_DELIVERY_WEBHOOK_SECRET=

# ---- Phone notifications (optional, Web Push / VAPID) — leave all three blank to keep push off ----
# Generate ONE key pair on your own computer, in this project folder:   npx web-push generate-vapid-keys
# Public key (browser-safe):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private key — SECRET, server-only. Never share it, never prefix it with NEXT_PUBLIC_.
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:operations@yourchurch.org  (or an https:// address)
VAPID_SUBJECT=

# ---- SMS (optional, Twilio) — server-only; leave blank to keep SMS off ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a sending number (E.164, e.g. +15551234567) or a Messaging Service SID
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
